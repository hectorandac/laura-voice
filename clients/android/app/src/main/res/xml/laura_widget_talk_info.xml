<?xml version="1.0" encoding="utf-8"?>
<!-- Talk to Laura: 2x1 by default (her face and state, tap to talk); the same widget as the card, other default size. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:configure="dev.hect.lauravoice.widget.WidgetConfigActivity"
    android:description="@string/widget_talk_description"
    android:initialLayout="@layout/glance_default_loading_layout"
    android:minWidth="110dp"
    android:minHeight="40dp"
    android:minResizeWidth="40dp"
    android:minResizeHeight="40dp"
    android:maxResizeWidth="600dp"
    android:maxResizeHeight="600dp"
    android:previewImage="@drawable/widget_preview_talk"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="2"
    android:targetCellHeight="1"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen|keyguard"
    android:widgetFeatures="reconfigurable|configuration_optional" />
